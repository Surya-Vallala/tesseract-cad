<?xml version="1.0" encoding="utf-8"?>
<!-- Tesseract CAD: a WebView shell that runs the app from files bundled inside the APK (works offline). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="co.tesseractstudio.cad">
    <!-- Only used when you tap Check for updates (the app asks first). Android grants it at install without a prompt. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Lets the app hand a downloaded update to Android's installer; Android asks you once ("Allow from this source"). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:label="Tesseract CAD"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/AppTheme"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|layoutDirection"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Open with" from Files, WhatsApp, Gmail… -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="image/vnd.dwg" />
                <data android:mimeType="image/x-dwg" />
                <data android:mimeType="application/acad" />
                <data android:mimeType="application/x-acad" />
                <data android:mimeType="application/autocad_dwg" />
                <data android:mimeType="application/dwg" />
                <data android:mimeType="application/x-dwg" />
                <data android:mimeType="application/x-autocad" />
                <data android:mimeType="drawing/dwg" />
                <data android:mimeType="image/vnd.dxf" />
                <data android:mimeType="image/x-dxf" />
                <data android:mimeType="application/dxf" />
                <data android:mimeType="application/x-dxf" />
                <data android:mimeType="drawing/x-dxf" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <!-- "Share" to Tesseract CAD -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/vnd.dwg" />
                <data android:mimeType="image/x-dwg" />
                <data android:mimeType="application/acad" />
                <data android:mimeType="application/x-acad" />
                <data android:mimeType="application/autocad_dwg" />
                <data android:mimeType="application/dwg" />
                <data android:mimeType="application/x-dwg" />
                <data android:mimeType="application/x-autocad" />
                <data android:mimeType="drawing/dwg" />
                <data android:mimeType="image/vnd.dxf" />
                <data android:mimeType="image/x-dxf" />
                <data android:mimeType="application/dxf" />
                <data android:mimeType="application/x-dxf" />
                <data android:mimeType="drawing/x-dxf" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

        <!-- Hands exported files (DWG, DXF, PDF…) to other apps through the share sheet -->
        <provider
            android:name=".ShareProvider"
            android:authorities="co.tesseractstudio.cad.share"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
